NODE_ENV=production
PORT=5000
DATABASE_URL=mysqls://USER:PASSWORD@HOST:3306/DATABASE
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
CLIENT_ORIGINS=https://portal.example.org
TRUST_PROXY=1

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=no-reply@example.org
SMTP_PASS=replace_me
SMTP_FROM="Genç İHH Erzurum" <no-reply@example.org>

# Run once for the first administrator, then remove or set to false.
ALLOW_BOOTSTRAP_ADMIN=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
