<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let the reverse proxy handle the API and uploaded media.
  RewriteRule ^(api|uploads)(/|$) - [L]

  # Serve real files and folders unchanged; render the React app for routes.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
